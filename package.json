{
  "name": "medshift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "turbo typecheck",
    "uat:smoke": "node scripts/uat-smoke.mjs",
    "api:dev": "pnpm --filter @medshift/api dev",
    "web:dev": "pnpm --filter @medshift/web dev",
    "admin:dev": "pnpm --filter @medshift/admin dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
