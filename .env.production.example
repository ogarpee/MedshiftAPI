# Copy this file to .env.production on the VPS and replace every example value.

# Public domains
WEB_ORIGIN=https://medshift.example.com
ADMIN_ORIGIN=https://admin.medshift.example.com
SOCKET_ORIGINS=https://medshift.example.com,https://admin.medshift.example.com

# Browser-bundled frontend config
NEXT_PUBLIC_API_URL=https://api.medshift.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.medshift.example.com
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# API runtime config
MONGODB_URI=mongodb://mongo:27017/medshift
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedShift <onboarding@resend.dev>
RESEND_WAITLIST_SEGMENT_ID=
RESEND_GENERAL_SEGMENT_ID=
RESEND_WORKER_SEGMENT_ID=
RESEND_FACILITY_SEGMENT_ID=
RESEND_SYNC_CONTACT_PROPERTIES=false

# Optional seed values
ADMIN_SEED_EMAIL=admin@medshift.example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
FACILITY_SEED_EMAIL=facility@medshift.example.com
FACILITY_SEED_PASSWORD=replace-with-a-strong-password
FACILITY_SEED_NAME=MedShift Demo Facility
